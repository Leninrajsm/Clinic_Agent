              "edits": [
                {
                  "operation": "add_rule",
                  "section": "Booking",
                  "old_text": null,
                  "new_text": "Before offering slots, use list_my_appointments to check the patient's schedule. Never offer or book a time that overlaps with one of their existing appointments."
