# Copy to .env and fill in. Only GEMINI_API_KEY is required.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: MongoDB Atlas connection string. Leave empty to use the in-memory database.
# Reviewers: use the reviewer connection string provided in the submission form.
MONGODB_URI=
MONGODB_DB=twocare_clinic

# Models. Flash for the high-volume roles (agent, simulated patient, judge: hundreds of calls per eval).
# Pro only for the analyzer: 1-3 calls per loop, where reasoning quality matters (cost difference ~Rs 25/loop).
# If your key can't use Pro (it has no free tier), the loop falls back to MODEL_ANALYZER_FALLBACK.
MODEL_AGENT=gemini-3.8-flash
MODEL_SIMULATOR=gemini-3.6-flash
MODEL_JUDGE=gemini-3.8-flash
MODEL_ANALYZER=gemini-3.1-pro-preview
MODEL_ANALYZER_FALLBACK=gemini-3.8-flash

# Rate limiting. Keep these low on a free-tier key.
LLM_MAX_CONCURRENCY=2
LLM_MAX_RPM=12
LLM_MAX_RETRIES=5
LLM_CALL_BUDGET=2500

# Clinic
CLINIC_TIMEZONE=America/New_York
# Freeze "now" for reproducible demos (ISO datetime). Empty = real clock. Evals always freeze their own clock.
FROZEN_NOW=
